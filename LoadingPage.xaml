<Page x:Class="AICA_Client.LoadingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AICA_Client"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoadingPage">

    <Grid>
        <Border BorderBrush="#000" BorderThickness="1" CornerRadius="20" Padding="20"
        Background="{StaticResource Brush.Card}"
        HorizontalAlignment="Center" VerticalAlignment="Center" Width="200">
            <TextBlock d:Text="처리중..." x:Name="content" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.GrayText}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>
