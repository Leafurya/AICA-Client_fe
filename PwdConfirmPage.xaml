<Page x:Class="AICA_Client.PwdConfirmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AICA_Client"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="400"
      Title="PwdConfirmPage">

    <Grid>
        <Border BorderBrush="#000" BorderThickness="1" CornerRadius="20" Padding="10" Background="{StaticResource Brush.Card}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="60">
            <Grid>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#666" Cursor="Hand"
                        x:Name="Close" Click="Close_Click"/>
                <StackPanel Margin="20">
                    <TextBlock VerticalAlignment="Center" Grid.ColumnSpan="2" Height="16" Margin="0,0,165,0">비밀번호</TextBlock>
                    <Grid Margin="0,10" Height="38">
                        <PasswordBox x:Name="PasswordTextBox" Padding="10" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Visibility="Visible"/>
                        <TextBox x:Name="PasswordTextBoxVisible" Padding="10" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Visibility="Collapsed"/>
                        <Button x:Name="ViewPwd" Width="24" Height="24" Content="👁" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                Click="ViewPwdBtn_Click"/>
                    </Grid>
                    <!--<PasswordBox x:Name="PasswordInput" Grid.Column="1" VerticalAlignment="Center" Height="18" Margin="0,0,0,10"/>-->
                    <Button x:Name="Confirm" Grid.Column="2" VerticalAlignment="Center" Content="비밀번호 확인" Click="Confirm_Click"
                            Height="40" Style="{StaticResource RoundedButton}"></Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
