<Page x:Class="AICA_Client.PronunciationTest"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AICA_Client"
      xmlns:viewmodel="clr-namespace:CustomControl.ViewModel;assembly=CustomControl"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PronunciationTest">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Page.DataContext>
        <StaticResource ResourceKey="vmShared" />
    </Page.DataContext>
    <Grid>
        <Border BorderBrush="#000" BorderThickness="1" CornerRadius="20" Padding="10"
            Background="{StaticResource Brush.Card}"
            HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="60">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#666" Cursor="Hand"
                        x:Name="Close" Click="Close_Click"/>
                <StackPanel Grid.Row="1" Margin="0,20,0,0" HorizontalAlignment="Center" Width="360">
                    <TextBlock Text="발음 비교" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.GrayText}"
                               HorizontalAlignment="Center" Margin="0,0,0,18"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <DockPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock FontWeight="Bold" Text="서버 연결 "></TextBlock>
                                <TextBlock Text="실패" Foreground="Red">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWSConnected}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="성공" Foreground="Green">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWSConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <DockPanel VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1">
                                <TextBlock FontWeight="Bold" Text="마이크 연결 "></TextBlock>
                                <TextBlock Text="실패" Foreground="Red">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMicConnected}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="성공" Foreground="Green">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMicConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Grid>
                        <DockPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" >
                            <TextBlock Text="장치 이름 "></TextBlock>
                            <TextBlock Text="{Binding MicDeviceName}"></TextBlock>
                        </DockPanel>
                    </Grid>
                    <Border Width="88" Height="88" CornerRadius="44" Background="Transparent"
                            HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Image Source="pack://application:,,,/styles/Image/login.png" Width="88" Height="63.3" Stretch="Fill"/>
                    </Border>
                    <TextBlock Text="아래 단어를 발음해 보세요" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Brush.GrayText}"
                               HorizontalAlignment="Center" Margin="0,0,0,18"/>
                    <TextBlock x:Name="txtWord" d:Text="hello"
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.GrayText}"
                               HorizontalAlignment="Center" Margin="0,0,0,18"></TextBlock>
                    <Grid>
                        <DockPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="발음 정확도: "
                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.GrayText}"
                                       Margin="0,0,0,18"></TextBlock>
                            <TextBlock Text="{Binding PronuncScore}"
                                       FontSize="20" FontWeight="Bold"></TextBlock>
                            <TextBlock Text="%"
                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.GrayText}"
                                       Margin="0,0,0,18"></TextBlock>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
