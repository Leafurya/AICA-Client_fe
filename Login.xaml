<Page x:Class="AICA_Client.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AICA_Client"
      mc:Ignorable="d" 
      d:DesignHeight="816" d:DesignWidth="816" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
      Title="Login">
    <Page.DataContext>
        <StaticResource ResourceKey="vmShared" />
    </Page.DataContext>

    <Grid>
        <Border BorderBrush="#000" BorderThickness="1" CornerRadius="20" Padding="10"
                Background="{StaticResource Brush.Card}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="60">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#666" Cursor="Hand"
                        x:Name="Close" Click="Close_Click"/>
                <StackPanel Grid.Row="1" Margin="0,20,0,0" HorizontalAlignment="Center" Width="360">
                    <TextBlock Text="로그인" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.GrayText}"
                               HorizontalAlignment="Center" Margin="0,0,0,18"/>
                    <Border Width="88" Height="88" CornerRadius="44" Background="Transparent"
                            HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Image Source="pack://application:,,,/styles/Image/login.png" Width="88" Height="63.3" Stretch="Fill"/>
                    </Border>
                    <TextBox x:Name="textBox_id" Style="{StaticResource InputBox}" Margin="0,0,0,10" Tag="ID"/>
                    <PasswordBox x:Name="textBox_pwd" Height="38" Margin="0,0,0,18" Padding="10"
                                 BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"/>
                    <Button Content="로그인" Style="{StaticResource RoundedButton}" Height="42" Margin="0,0,0,14"
                            Click="Button_Click"/>
                    <CheckBox Content="로그인 상태 유지" Foreground="#555" HorizontalAlignment="Center" Margin="0,0,0,14"
                              Checked="RememberMeToggleButton_Checked" Unchecked="RememberMeToggleButton_Unchecked"
                              x:Name="RememberMeToggleButton"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
