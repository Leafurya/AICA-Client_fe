<Page x:Class="AICA_Client.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AICA_Client"
      mc:Ignorable="d" 
      d:DesignHeight="816" d:DesignWidth="816"
      Title="Login">

    <Grid>
        <Border BorderBrush="#000" BorderThickness="1" CornerRadius="20" Padding="10" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="3*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <TextBlock TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">로그인</TextBlock>
                    <TextBlock TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1"> image</TextBlock>
                    <TextBox Grid.Row="2" Margin="10"></TextBox>
                    <TextBox Grid.Row="3" Margin="10"></TextBox>
                    <Button Grid.Row="4" Margin="10" Content="로그인"></Button>
                    <Border Grid.Row="5" BorderThickness="0,0,0,2" BorderBrush="Gray">
                        <DockPanel Margin="10">
                            <ToggleButton Width="20" Height="20" VerticalAlignment="Center"></ToggleButton>
                            <TextBlock VerticalAlignment="Center">로그인 상태 유지</TextBlock>
                        </DockPanel>
                    </Border>
                    <TextBlock Grid.Row="6" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">SNS 간편 로그인</TextBlock>
                    <TextBlock Grid.Row="7" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">카카오 아이콘</TextBlock>
                    <Button Grid.Row="9" HorizontalAlignment="Center" VerticalAlignment="Center" Content="회원가입" Padding="20,10,20,10"></Button>
                </Grid>
                <Button x:Name="Close" Grid.Column="2" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="top" Content="❌" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
