                        <TextBlock VerticalAlignment="Center" Foreground="#555">로그인 상태 유지</TextBlock>
                    </DockPanel>-->
                    <CheckBox Content="로그인 상태 유지" Foreground="#555" HorizontalAlignment="Center" Margin="0,0,0,14"
                              Checked="RememberMeToggleButton_Checked" Unchecked="RememberMeToggleButton_Unchecked"
                              x:Name="RememberMeToggleButton"/>
                </StackPanel>
            </Grid>
