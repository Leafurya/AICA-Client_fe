<UserControl x:Class="CustomControl.SentenceItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomControl"
             xmlns:viewmodel="clr-namespace:CustomControl.ViewModel"
             d:DataContext="{d:DesignInstance Type=viewmodel:SharedViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="35" d:DesignWidth="800" Height="35" HorizontalAlignment="Stretch">
    <Grid Margin="0,7,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <CheckBox Unchecked="ToggleButton_Unchecked"
                  x:Name="toggleBtn" VerticalAlignment="Center"/>
        <TextBlock VerticalAlignment="Center" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Name="Text" Grid.Column="1" MouseLeftButtonUp="Text_MouseLeftButtonUp" Text="{Binding sentence}" Tag="{Binding sentenceId}"></TextBlock>
    </Grid>
</UserControl>
