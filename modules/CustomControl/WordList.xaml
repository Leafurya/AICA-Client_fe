<UserControl x:Class="CustomControl.WordList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="243.797"
             local:WordItem.OpenMeaningCard="UserControl_OpenMeaningCard">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <!--검색창-->
        <!--<Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Name="searchBtn" Content="검색" Style="{StaticResource RoundedButton}"
                    Margin="8,0,0,0"/>
        </Grid>-->
            <TextBox Style="{StaticResource SearchBox}" Name="searchTxt" Tag="검색어를 입력하세요"
                     Text="{Binding WordSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
        <!--<TextBox Grid.Row="0" Margin="20,10,20,10"></TextBox>-->

        <!--삭제-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <DockPanel VerticalAlignment="Center">
                <CheckBox x:Name="toggleButtonSelectAll"  MinWidth="88"
                          VerticalAlignment="Center" HorizontalAlignment="Left"
                          Content="전체 선택"
                          Checked="toggleButtonSelectAll_Checked" Unchecked="toggleButtonSelectAll_Unchecked"></CheckBox>
                <!--<TextBlock VerticalAlignment="Center">전체 선택</TextBlock>-->
            </DockPanel>
            <DockPanel Grid.Column="1">
                <Button Content="선택 삭제" Width="98" Height="28"
                        VerticalAlignment="Center" HorizontalAlignment="right"
                        Click="Button_Click"
                        Style="{StaticResource RoundedButton}"/>
            </DockPanel>
        </Grid>
        <!--<Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <ToggleButton x:Name="toggleButtonSelectAll" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20 0 0 0" Checked="toggleButtonSelectAll_Checked" Unchecked="toggleButtonSelectAll_Unchecked"></ToggleButton>
                <TextBlock VerticalAlignment="Center">전체 선택</TextBlock>
            </DockPanel>
            <DockPanel Grid.Column="1">
                <Button Content="선택 삭제" Width="98" Height="28" VerticalAlignment="Center" HorizontalAlignment="right" Margin="0 0 20 0" Click="Button_Click"/>
            </DockPanel>
        </Grid>-->
        <ScrollViewer Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Style="{StaticResource ScrollViewTransparent}">
            <StackPanel>
                <ItemsControl x:Name="itemsControl" ItemsSource="{Binding FilteredWordList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:WordItem></local:WordItem>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Name="Notice" Grid.Row="2" Visibility="Visible"  Padding="0" Background="{StaticResource Brush.Mint}">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,48,0,0">
                <Image Source="pack://application:,,,/styles/Image/tip.png" Width="96" Height="96" Stretch="Uniform" Margin="0,0,0,10"/>
                <TextBlock Text="Tip!" FontSize="16" FontWeight="Bold" Foreground="#56C7A3"
                                                   TextAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="로그인을 하고 단어장 기능을 사용해보세요!&#10;에이카가 도와드릴게요!" FontSize="13" Foreground="#6C7A89"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
        <!--<TextBlock Grid.Row="2" Visibility="Visible" Name="Notice" Background="AliceBlue">
            로그인 후 이용 가능
        </TextBlock>-->
    </Grid>
</UserControl>
