<UserControl x:Class="CustomControl.AicaItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomControl"
             xmlns:viewmodel="clr-namespace:CustomControl.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <viewmodel:POSConverter x:Key="PosConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="toggleBtn" Height="20" Width="20" Unchecked="toggleBtn_Unchecked"/>
            <TextBlock x:Name="Word" Grid.Column="1" Text="{Binding word}" Tag="{Binding wordId}" MouseLeftButtonUp="Word_MouseLeftButtonUp"></TextBlock>
        </Grid>
    </Grid>
</UserControl>
