<UserControl x:Class="CustomControl.AicaItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomControl"
             xmlns:viewmodel="clr-namespace:CustomControl.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <viewmodel:POSConverter x:Key="PosConverter"/>
    </UserControl.Resources>
    <Grid Margin="0,7,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock FontSize="15" x:Name="Word" Grid.Column="1" Text="{Binding word}" Tag="{Binding wordId}" MouseLeftButtonUp="Word_MouseLeftButtonUp"></TextBlock>
    </Grid>
</UserControl>
