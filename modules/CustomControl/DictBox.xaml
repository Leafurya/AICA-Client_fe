<UserControl x:Class="CustomControl.DictBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="226.097" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="1" Text="{Binding DictionaryMean}"></TextBlock>
        <Button Grid.Row="1" Margin="10,10,10,10" Content="+" Click="Button_Click"></Button>
    </Grid>
</UserControl>
