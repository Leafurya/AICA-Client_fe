<UserControl x:Class="CustomControl.WordItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomControl"
             xmlns:viewmodel="clr-namespace:CustomControl.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800"
             Height="auto">
    <UserControl.Resources>
        <viewmodel:POSConverter x:Key="PosConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="toggleBtn" Height="20" Width="20"></ToggleButton>
            <TextBlock x:Name="Word" Grid.Column="1" Text="{Binding word}" Tag="{Binding wordId}" MouseLeftButtonUp="Word_MouseLeftButtonUp"></TextBlock>
        </Grid>
        <Grid x:Name="MeaningsGrid" Grid.Row="1" Visibility="Collapsed">
            <ItemsControl ItemsSource="{Binding meanings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding partOfSpeech, Converter={StaticResource PosConverter}}"></TextBlock>
                            <TextBlock Text="{Binding meaning}"></TextBlock>
                            <Border BorderBrush="gray" BorderThickness="2,0,0,0" Padding="10,0,0,0">
                                <ItemsControl ItemsSource="{Binding exampleSentences}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding sentence}"></TextBlock>
                                                <TextBlock Text="{Binding meaning}"></TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
