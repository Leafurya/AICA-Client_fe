<UserControl x:Class="CustomControl.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomControl" xmlns:viewmodel="clr-namespace:CustomControl.ViewModel"
             d:DataContext="{d:DesignInstance Type=viewmodel:SharedViewModel}"
             mc:Ignorable="d" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" d:DesignHeight="551" d:DesignWidth="448">
    
    <Grid Margin="18,0,18,16" Background="{StaticResource Brush.Card}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!--<RowDefinition Height="12"/>-->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>
        <!--<Grid.RowDefinitions> origin
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>-->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,8,0,8">
            <TextBlock Text="문장 입력" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ToggleButton Content="검색모드"
                          Name="toggleBtnMode"
                          DockPanel.Dock="Right"
                          IsChecked="{Binding IsSearchModeToggleOn}"
                          Style="{StaticResource RoundedToggle}"
                          Height="32" MinWidth="100" Margin="8,0,0,0"
                          Checked="ToggleBtnMode_Checked" Unchecked="ToggleBtnMode_Unchecked"/>
            <Button Content="📷 이미지로 가져오기"
                    Name="btnSelectImg"
                    Style="{StaticResource RoundedButton}"
                    Height="32" MinWidth="150"
                    Margin="8,0,0,0" DockPanel.Dock="Right"
                    Click="btnSelectImg_Click"/>
            <!--<ToggleButton Name="toggleBtnMode" Width="20" IsChecked="{Binding IsSearchModeToggleOn}"  Checked="ToggleBtnMode_Checked" Unchecked="ToggleBtnMode_Unchecked"/> origin
            <TextBlock>검색모드</TextBlock>
            <Button Name="btnSelectImg" Content="이미지 선택" Click="btnSelectImg_Click"/>-->
        </DockPanel>
        <Grid Grid.Row="1" VerticalAlignment="Stretch">
            <!--<Grid.RowDefinitions>
                <RowDefinition Height="2*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>-->
            <Border Background="#F8FAFB" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8"/>
            <RichTextBox x:Name="textBoxSearcher"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         TextChanged="textBoxSearcher_TextChanged"
                         FontSize="18" Background="Transparent"
                         BorderThickness="0"
                         ToolTip="검색모드에서 단어 클릭하면 가운데 사전 의미가 뜹니다.">
                <FlowDocument>
                    <Paragraph>
                        <Run Text=""/>
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
            <Canvas Visibility="Collapsed" Name="canvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    Background="Transparent" Cursor="Hand"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp" MouseMove="Canvas_MouseMove" MouseWheel="Canvas_MouseWheel">
                <Popup x:Name="wordDataOverlay"
                       PlacementTarget="{Binding ElementName=canvas}"
                       Placement="RelativePoint"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       IsOpen="False">
                    <Border x:Name="OverlayCard"
                            Background="#DD222222"
                            CornerRadius="10"
                            Padding="12"
                            Opacity="1">
                        <StackPanel>
                            <TextBlock Text="{Binding OverlayWord}" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Foreground="#DDD" Margin="0,4,0,0">
                                <Run Text="품사: "/>
                                <Run Text="{Binding OverlayPos}"/>
                            </TextBlock>
                            <TextBlock Foreground="#DDD" Margin="0,4,0,0">
                                <Run Text="세부태그: "/>
                                <Run Text="{Binding OverlayTag}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Popup>
            </Canvas>
        </Grid>
        <TextBlock Grid.Row="2" Text="번역 결과" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8"/>
        <Grid Grid.Row="3">
            <Border Background="#FFFFFF" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8"/>
            <TextBlock FontSize="18"
                       x:Name="textBlockTranslator"
                       Text="{Binding TranslateResult}"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>
