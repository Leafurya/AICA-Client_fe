    <ProjectReference Include="..\VocabNote\VocabNote.csproj" />
    <ProjectReference Include="..\WordSearch\WordSearch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="SearchBox.xaml.cs">
