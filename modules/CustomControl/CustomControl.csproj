    </Compile>
    <Compile Update="SentenceItem.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="WordItem.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

</Project>
