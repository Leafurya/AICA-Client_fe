<Page x:Class="AICA_Client.MyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AICA_Client"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MyPage" Loaded="Page_Loaded">
    <Page.DataContext>
        <StaticResource ResourceKey="vmShared" />
    </Page.DataContext>

    <Grid>
        <Border BorderBrush="#000" BorderThickness="1" CornerRadius="20" Padding="10" Background="{StaticResource Brush.Card}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="60">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#666" Cursor="Hand"
                        Click="Close_Click"/>
                <StackPanel Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Center" Width="360">
                    <Border Width="88" Height="88" CornerRadius="44" Background="{StaticResource Brush.MintAccent}"
                HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Image Source="pack://application:,,,/styles/Image/User.png" Stretch="Fill"/>
                    </Border>
                    <TextBlock Text="{Binding UserInfoAlias}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <Button x:Name="EditInfoButton" Content="내 정보 수정" Style="{StaticResource RoundedButton}" Height="30" MinWidth="100"
                            Background="#E0E3E7" HorizontalAlignment="Center" Margin="0,0,0,12"
                            Click="EditInfoButton_Click"/>
                    <DockPanel Margin="0,6">
                        <TextBlock Style="{StaticResource UserInfo}" Text="아이디: "/>
                        <TextBlock Style="{StaticResource UserInfo}" Text="{Binding UserInfoID}"/>
                    </DockPanel>
                    <DockPanel Margin="0,6">
                        <TextBlock Style="{StaticResource UserInfo}" Text="이메일: "/>
                        <TextBlock Style="{StaticResource UserInfo}" Text="{Binding UserInfoEmail}"/>
                    </DockPanel>

                    <Button x:Name="LogoutButton" Content="로그아웃" Height="38" Margin="0,12,0,0" Style="{StaticResource RoundedButton}"
                            Click="LogoutButton_Click"/>
                    <Button x:Name="LeaveMemberButton" Content="회원탈퇴" Background="#EF5355" Foreground="White" Height="38" Margin="0,12,0,0" BorderThickness="0"
                            Style="{StaticResource RoundedButton}"
                            Click="LeaveMemberButton_Click"/>
                </StackPanel>
            </Grid>
