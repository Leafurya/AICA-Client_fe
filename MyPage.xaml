<Page x:Class="AICA_Client.MyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AICA_Client"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MyPage" Loaded="Page_Loaded">
    <Page.DataContext>
        <StaticResource ResourceKey="vmShared" />
    </Page.DataContext>

    <Grid>
        <Border BorderBrush="#000" BorderThickness="1" CornerRadius="20" Padding="10" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="3*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <TextBlock TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">내 정보</TextBlock>
                    <DockPanel Grid.Row="1">
                        <TextBlock VerticalAlignment="Center">아이디: </TextBlock>
                        <TextBlock VerticalAlignment="Center" Text="{Binding UserInfoID}"></TextBlock>
                    </DockPanel>
                    <DockPanel Grid.Row="2">
                        <TextBlock VerticalAlignment="Center">이메일:</TextBlock>
                        <TextBlock VerticalAlignment="Center" Text="{Binding UserInfoEmail}"></TextBlock>
                    </DockPanel>
                    <DockPanel Grid.Row="3">
                        <TextBlock VerticalAlignment="Center">닉네임:</TextBlock>
                        <TextBlock VerticalAlignment="Center" Text="{Binding UserInfoAlias}"></TextBlock>
                    </DockPanel>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EditInfoButton" Grid.Column="0" Margin="10" Content="회원 정보 수정" Click="EditInfoButton_Click"></Button>
                        <Button x:Name="LogoutButton" Grid.Column="1" Margin="10" Content="로그아웃" Click="LogoutButton_Click"></Button>
                        <Button x:Name="LeaveMemberButton" Grid.Column="2" Margin="10" Content="회원 탈퇴" Click="LeaveMemberButton_Click"></Button>
                    </Grid>
                </Grid>
                <Button x:Name="Close" Grid.Column="2" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="top" Content="❌" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
