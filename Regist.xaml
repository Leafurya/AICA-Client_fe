<Page x:Class="AICA_Client.Regist"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AICA_Client"
      mc:Ignorable="d" 
      d:DesignHeight="1816" d:DesignWidth="816"
      Title="Regist">
    <Page.DataContext>
        <StaticResource ResourceKey="vmShared" />
    </Page.DataContext>
    <Grid>
        <Border BorderBrush="#000" BorderThickness="1" CornerRadius="20" Padding="10" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="3*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                            
                        <TextBlock TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">회원가입</TextBlock>
                        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="20,30,20,30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="100"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBlock>아이디</TextBlock>
                                <TextBox x:Name="UserIdTextBox" Width="250"  VerticalAlignment="Center" HorizontalAlignment="Left" BorderThickness="0" Margin="20,0,0,0"/>
                                <Button x:Name="VerifyIdButton" Grid.Column="1" Content="중복확인" Margin="20" Click="VerifyIdButton_Click"></Button>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="20,30,20,30">
                            <Grid>
                                <TextBlock>비밀번호</TextBlock>
                                <PasswordBox x:Name="PasswordTextBox" Width="250"  VerticalAlignment="Center" HorizontalAlignment="Left" BorderThickness="0" Margin="20" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="20,30,20,30">
                            <Grid>
                                <TextBlock>비밀번호 확인</TextBlock>
                                <PasswordBox x:Name="RePasswordTextBox" VerticalAlignment="Center" BorderThickness="0" Margin="20"></PasswordBox>
                            </Grid>
                        </Border>
                        <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="20,30,20,30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="100"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBlock>이메일</TextBlock>
                                <TextBox x:Name="EmailTextBox" VerticalAlignment="Center" BorderThickness="0" Margin="20,0,0,0"></TextBox>
                                <Button x:Name="SendVerifyCodeButton" Grid.Column="1" Content="인증번호 전송" Margin="10,20,10,20" Click="SendVerifyCodeButton_Click"></Button>
                            </Grid>
                        </Border>
                        <Border Grid.Row="5" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="20,30,20,30">
                            <Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="100"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel>
                                        <TextBlock>인증 번호 </TextBlock>
                                        <TextBlock x:Name="TimerTextBlock"></TextBlock>
                                    </DockPanel>
                                    <TextBox x:Name="VerifyCodeTextBox" VerticalAlignment="Center" BorderThickness="0" Margin="20,0,0,0"></TextBox>
                                    <Button x:Name="VerifyCodeButton" Grid.Column="1" Content="인증번호 확인" Margin="10,20,10,20" Click="VerifyCodeButton_Click"></Button>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="6" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="20,30,20,30">
                            <Grid>
                                <TextBlock>닉네임</TextBlock>
                                <TextBox x:Name="AliasTextBox" VerticalAlignment="Center" BorderThickness="0" Margin="20"></TextBox>
                            </Grid>
                        </Border>
                        <DockPanel Grid.Row="7" Margin="10">
                            <ToggleButton x:Name="AgreeCheckBox1" Width="20" Height="20" VerticalAlignment="Center"></ToggleButton>
                            <TextBlock VerticalAlignment="Center">이용약관 (필수)</TextBlock>
                        </DockPanel>
                        <DockPanel Grid.Row="8" Margin="10">
                            <ToggleButton x:Name="AgreeCheckBox2" Width="20" Height="20" VerticalAlignment="Center"></ToggleButton>
                            <TextBlock VerticalAlignment="Center">개인정보의 수집 및 이용에 대한 동의(필수)</TextBlock>
                        </DockPanel>
                        <DockPanel Grid.Row="9" Margin="10">
                            <ToggleButton x:Name="AgreeCheckBox3" Width="20" Height="20" VerticalAlignment="Center"></ToggleButton>
                            <TextBlock VerticalAlignment="Center">마케팅 정보 수신에 동의합니다.(선택)</TextBlock>
                        </DockPanel>
                        <Button x:Name="DoRegistButton" Grid.Row="10" Margin="10" Content="회원가입" Click="DoRegistButton_Click"></Button>
                    </Grid>
                </ScrollViewer>
                <Button x:Name="Close" Grid.Column="2" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="top" Content="❌" Click="Close_Click"></Button>
            </Grid>
        </Border>
    </Grid>
</Page>
