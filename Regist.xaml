                                    <TextBox x:Name="VerifyCodeTextBox" VerticalAlignment="Center" BorderThickness="0" Margin="20,0,0,0"></TextBox>
                                    <Button x:Name="VerifyCodeButton" Grid.Column="1" Content="인증번호 확인" Margin="10,20,10,20" Click="VerifyCodeButton_Click"></Button>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="6" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="20,30,20,30">
                            <Grid>
                                <TextBlock>닉네임</TextBlock>
                                <TextBox x:Name="AliasTextBox" VerticalAlignment="Center" BorderThickness="0" Margin="20"></TextBox>
                            </Grid>
                        </Border>
                        <DockPanel Grid.Row="7" Margin="10">
                            <ToggleButton x:Name="AgreeCheckBox1" Width="20" Height="20" VerticalAlignment="Center"></ToggleButton>
